{
  "name": "dsh-skillbox",
  "version": "0.2.2",
  "description": "Skill shelf for DeepSeek Harness (dsh): list every skill DSH resolves and uninstall or restore any of them from Settings — a reversible move into quarantine that never deletes a file. · DSH 技能控制台：在设置里总览 DSH 解析到的全部技能，可卸载/恢复；卸载是移入隔离区，绝不删除文件。",
  "type": "module",
  "license": "MIT",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/host.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "skill",
    "skills",
    "skill-manager",
    "settings"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BB0027/dsh-skillbox.git"
  },
  "homepage": "https://github.com/BB0027/dsh-skillbox#readme",
  "bugs": {
    "url": "https://github.com/BB0027/dsh-skillbox/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
